NEXT_PUBLIC_APP_NAME=DetectGrowth
# Leave blank to use the Next.js same-origin API routes locally.
# Set this to the public Go API URL only when using the external backend.
NEXT_PUBLIC_API_URL=
# Use public job-board feeds for live openings. Set to demo for deterministic fixtures.
JOBS_DATA_MODE=live
# Server-only AI personalization settings. Never expose OPENAI_API_KEY as NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
